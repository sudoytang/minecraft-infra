#!/bin/bash
set -euo pipefail

service=minecraft.service
root=/srv/minecraft
templates=/usr/local/share/minecraft-admin
afk_user=ytang
afk_service=minecraft-afk-bot.service
afk_program=afk-azalea

usage() {
    echo "Usage: minecraft-admin ACTION [ARGS]" >&2
    echo "Actions:" >&2
    echo "  start stop restart status logs" >&2
    echo "  backup backup-list backup-check backup-mode" >&2
    echo "  auth-config-apply auth-test-on auth-test-off" >&2
    echo "  whitelist-add whitelist-remove whitelist-list" >&2
    echo "  ops-list ops-add ops-remove" >&2
    echo "  props-get [KEY]  props-set KEY VALUE" >&2
    echo "  plugins-list tree du" >&2
    echo "  afk status|start|stop|restart" >&2
    echo "  disk mem" >&2
    echo "  rcon <command...>" >&2
    exit 2
}

restart_if_active() {
    local was_active=no
    if /usr/bin/systemctl is-active --quiet "$service"; then
        was_active=yes
        /usr/bin/systemctl stop "$service"
    fi
    local result=0
    if "$@"; then
        result=0
    else
        result=$?
    fi
    if [[ "$was_active" == yes ]]; then
        /usr/bin/systemctl start "$service"
    fi
    return "$result"
}

install_properties() {
    local source=$1
    [[ -f "$source" && ! -L "$source" ]] || exit 1
    /usr/bin/cp -a \
        "$root/server.properties" \
        "$root/server.properties.previous"
    /usr/bin/install \
        -o minecraft \
        -g minecraft \
        -m 0640 \
        "$source" \
        "$root/server.properties"
}

install_auth_config() {
    local source="$templates/authme-config.yml"
    local target="$root/plugins/AuthMe/config.yml"
    [[ -f "$source" && ! -L "$source" ]] || exit 1
    /usr/bin/cp -a "$target" "$target.previous"
    /usr/bin/install \
        -o minecraft \
        -g minecraft \
        -m 0640 \
        "$source" \
        "$target"
}

edit_whitelist() {
    local operation=$1
    local username=$2
    [[ "$username" =~ ^[A-Za-z0-9_]{3,16}$ ]] || {
        echo "Invalid username: $username" >&2
        exit 2
    }
    /usr/bin/python3 -I - "$operation" "$username" <<'PY'
import hashlib
import json
import grp
import os
import pwd
import sys
import uuid

path = "/srv/minecraft/whitelist.json"
operation, name = sys.argv[1:]

try:
    with open(path, encoding="utf-8") as handle:
        entries = json.load(handle)
except FileNotFoundError:
    entries = []

if not isinstance(entries, list):
    raise SystemExit("whitelist.json is not a JSON list")

old = list(entries)
entries = [
    item for item in entries
    if str(item.get("name", "")).casefold() != name.casefold()
]

if operation == "add":
    raw = bytearray(
        hashlib.md5(("OfflinePlayer:" + name).encode("utf-8")).digest()
    )
    raw[6] = (raw[6] & 0x0f) | 0x30
    raw[8] = (raw[8] & 0x3f) | 0x80
    entries.append({"uuid": str(uuid.UUID(bytes=bytes(raw))), "name": name})

if os.path.exists(path):
    with open(path + ".previous", "w", encoding="utf-8") as handle:
        json.dump(old, handle, indent=2)
        handle.write("\n")

temporary = path + ".tmp"
with open(temporary, "w", encoding="utf-8") as handle:
    json.dump(entries, handle, indent=2)
    handle.write("\n")
uid = pwd.getpwnam("minecraft").pw_uid
gid = grp.getgrnam("minecraft").gr_gid
os.chown(temporary, uid, gid)
os.chmod(temporary, 0o640)
os.replace(temporary, path)
PY
}

edit_ops() {
    local operation=$1
    local username=$2
    [[ "$username" =~ ^[A-Za-z0-9_]{3,16}$ ]] || {
        echo "Invalid username: $username" >&2
        exit 2
    }
    /usr/bin/python3 -I - "$operation" "$username" <<'PY'
import hashlib
import json
import grp
import os
import pwd
import sys
import uuid

path = "/srv/minecraft/ops.json"
operation, name = sys.argv[1:]

try:
    with open(path, encoding="utf-8") as handle:
