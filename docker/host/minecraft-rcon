#!/usr/bin/python3
import os
import socket
import struct
import sys

PROPERTIES = "/srv/minecraft/server.properties"

def read_packet(sock):
    def exact(n):
        data = bytearray()
        while len(data) < n:
            chunk = sock.recv(n - len(data))
            if not chunk:
                raise RuntimeError("RCON connection closed unexpectedly")
            data.extend(chunk)
        return bytes(data)
    length = struct.unpack("<i", exact(4))[0]
    if length < 10 or length > 4 * 1024 * 1024:
        raise RuntimeError("Invalid RCON response")
    data = exact(length)
    request_id, packet_type = struct.unpack("<ii", data[:8])
    return request_id, packet_type, data[8:-2].decode("utf-8", "replace")

def send_packet(sock, request_id, packet_type, body):
    payload = struct.pack("<ii", request_id, packet_type) + body.encode("utf-8") + b"\0\0"
    sock.sendall(struct.pack("<i", len(payload)) + payload)

def main():
    if len(sys.argv) < 2:
        raise SystemExit("Usage: minecraft-admin rcon <console command>")
    values = {}
    with open(PROPERTIES, encoding="utf-8") as handle:
        for raw in handle:
            line = raw.strip()
            if line and not line.startswith("#") and "=" in line:
                key, value = line.split("=", 1)
                values[key.strip()] = value.strip()
    if values.get("enable-rcon", "false").lower() != "true":
        raise SystemExit("RCON is disabled in server.properties")
    host = values.get("rcon.ip", "127.0.0.1") or "127.0.0.1"
    if host in ("0.0.0.0", "::"):
        host = "127.0.0.1"
    if host not in ("127.0.0.1", "localhost", "::1"):
        raise SystemExit("RCON helper only connects to loopback for safety")
    password = values.get("rcon.password", "")
    if not password:
        raise SystemExit("RCON password is missing in server.properties")
    port = int(values.get("rcon.port", "25575"))
    command = " ".join(sys.argv[1:])
    with socket.create_connection((host, port), timeout=5) as sock:
        sock.settimeout(5)
        send_packet(sock, 1, 3, password)
        response_id, _, _ = read_packet(sock)
        if response_id == -1:
            raise SystemExit("RCON authentication failed")
        send_packet(sock, 2, 2, command)
        response_id, _, response = read_packet(sock)
        if response_id != 2:
            raise SystemExit("Unexpected RCON response")
        if response:
            print(response, end="" if response.endswith("\n") else "\n")

if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, RuntimeError) as exc:
        print("RCON error: " + str(exc), file=sys.stderr)
        raise SystemExit(1)
